// Документ: РеализацияТоваров
// Реквизит документа: Склад
// Табличная часть Товары: Номенклатура, Количество, Цена, Сумма
// Регистр накопления ТоварныеОстатки: Номенклатура, Склад, Количество.
// Общий серверный модуль: УправлениеОстаткамиСервер.

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    Если Не ЗначениеЗаполнено(Склад) Тогда
        Отказ = Истина;
        Сообщить("Не указан склад реализации.");
        Возврат;
    КонецЕсли;

    Если Товары.Количество() = 0 Тогда
        Отказ = Истина;
        Сообщить("Нельзя провести пустую реализацию.");
        Возврат;
    КонецЕсли;

    // Сначала суммируем одинаковые товары из разных строк документа,
    // чтобы не допустить превышения остатка из-за разбиения на строки.
    КоличествоПоНоменклатуре = Новый Соответствие;

    Для Каждого СтрокаТовара Из Товары Цикл

        Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
            Отказ = Истина;
            Сообщить("В строке реализации не указана номенклатура.");
            Возврат;
        КонецЕсли;

        Если СтрокаТовара.Количество <= 0 Тогда
            Отказ = Истина;
            Сообщить("Количество товара должно быть больше нуля.");
            Возврат;
        КонецЕсли;

        ТекущееКоличество = КоличествоПоНоменклатуре.Получить(
            СтрокаТовара.Номенклатура
        );

        Если ТекущееКоличество = Неопределено Тогда
            ТекущееКоличество = 0;
        КонецЕсли;

        КоличествоПоНоменклатуре.Вставить(
            СтрокаТовара.Номенклатура,
            ТекущееКоличество + СтрокаТовара.Количество
        );

    КонецЦикла;

    // Проверяем суммарную потребность по каждой номенклатуре.
    Для Каждого Пара Из КоличествоПоНоменклатуре Цикл

        Доступно = УправлениеОстаткамиСервер.ПолучитьКоличествоОстатка(
            Пара.Ключ,
            Склад,
            Дата
        );

        Если Доступно < Пара.Значение Тогда
            Отказ = Истина;
            Сообщить(
                "Недостаточно товара на складе. Доступно: "
                + Строка(Доступно)
                + ", требуется: "
                + Строка(Пара.Значение)
            );
            Возврат;
        КонецЕсли;

    КонецЦикла;

    // Формируем расходные движения после успешной проверки всех строк.
    Движения.ТоварныеОстатки.Записывать = Истина;

    Для Каждого СтрокаТовара Из Товары Цикл

        Движение = Движения.ТоварныеОстатки.Добавить();
        Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
        Движение.Период = Дата;
        Движение.Номенклатура = СтрокаТовара.Номенклатура;
        Движение.Склад = Склад;
        Движение.Количество = СтрокаТовара.Количество;

    КонецЦикла;

КонецПроцедуры

// Важно: этот пример демонстрирует проверку бизнес-правила.
// Для многопользовательской работы необходимо добавить блокировки
// и повторную проверку остатков в транзакционно безопасном контексте.
