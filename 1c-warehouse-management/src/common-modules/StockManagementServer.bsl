// Общий модуль: УправлениеОстаткамиСервер
// Свойства модуля: Сервер = Истина, Экспорт = Истина.
// Предполагается регистр накопления ТоварныеОстатки (вид Остатки)
// с измерениями Номенклатура, Склад и ресурсом Количество.

Функция ПолучитьКоличествоОстатка(Номенклатура, Склад, МоментВремени) Экспорт

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Остатки.КоличествоОстаток КАК КоличествоОстаток
    |ИЗ
    |    РегистрНакопления.ТоварныеОстатки.Остатки(
    |        &МоментВремени,
    |        Склад = &Склад
    |            И Номенклатура = &Номенклатура
    |    ) КАК Остатки";

    Запрос.УстановитьПараметр("МоментВремени", МоментВремени);
    Запрос.УстановитьПараметр("Склад", Склад);
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);

    Выборка = Запрос.Выполнить().Выбрать();

    Если Выборка.Следующий() Тогда
        Возврат Выборка.КоличествоОстаток;
    КонецЕсли;

    Возврат 0;

КонецФункции
