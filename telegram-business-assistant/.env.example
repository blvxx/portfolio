# Required. Create a bot with @BotFather and keep this token private.
BOT_TOKEN=123456789:replace_with_real_token

# Local SQLite file. The parent directory is created automatically.
DATABASE_PATH=data/leads.sqlite3

# Optional Telegram chat ID that receives new lead notifications.
# For a private chat, the bot must be started by the admin first.
ADMIN_CHAT_ID=

# Optional numeric Telegram user ID allowed to run /leads.
ADMIN_USER_ID=
